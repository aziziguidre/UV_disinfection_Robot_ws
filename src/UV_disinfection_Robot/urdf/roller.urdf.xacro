<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="roller_macro" params="parent name xyz rpy">

        <link name="roller_${name}_rim_${parent}_link">

            <inertial>
                <mass value="0.05"/>
                <inertia ixx="2.78642013e-06" ixy="0" ixz="0" iyy="2.78642013e-6" iyz="0" izz="1.62134920e-06"/>
            </inertial>
        
            <visual>
                <geometry>
                    <mesh filename="package://uv_disinfection_robot/meshes/roller.stl" scale="1 1 1"/>
                </geometry>
                <material name="roller_material">
                    <color rgba="0.1 0.1 0.1 1"/>
                </material>
            </visual>
        </link>
        
        <gazebo reference="roller_${parent}_${name}_link">
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
            <kp>100000.0</kp>
            <kd>10.0</kd>
            <minDepth>0.001</minDepth>
        </gazebo> 
        
        <joint name="roller_${name}_rim_${parent}_joint" type="fixed">
            <parent link="rim_${parent}_link"/>
            <child link="roller_${name}_rim_${parent}_link"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>

        <gazebo reference="roller_${name}_rim_${parent}_link">
            <material>Gazebo/Black</material>
        </gazebo>

    </xacro:macro>
</robot>
