<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="chiron_uv">

    <xacro:include filename="$(find uv_disinfection_robot)/urdf/rim.urdf.xacro"/>
    <xacro:include filename="$(find uv_disinfection_robot)/urdf/macros.xacro"/>
    <xacro:include filename="$(find uv_disinfection_robot)/urdf/tube.urdf.xacro"/>

    <xacro:arg name="samples" default="360"/>
    <xacro:arg name="vertical_samples" default="32"/>
    <xacro:arg name="update_rate" default="2"/>

    <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
    <material name="blue"><color rgba="0.203125 0.23828125 0.28515625 1.0"/></material>
    <material name="green"><color rgba="0.0 0.8 0.0 1.0"/></material>
    <material name="grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    <material name="orange"><color rgba="1.0 0.423529411765 0.0392156862745 1.0"/></material>
    <material name="brown"><color rgba="0.870588235294 0.811764705882 0.764705882353 1.0"/></material>
    <material name="red"><color rgba="0.80078125 0.12890625 0.1328125 1.0"/></material>
    <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>

    <link name="origin_link"/>
    <link name="nav_base"/>

    <joint name="nav_base_joint" type="fixed">
        <parent link="origin_link"/>
        <child link="nav_base"/>
        <origin xyz="0 0 0" rpy="0 0 1.570796"/>
    </joint>

    <link name="base_link">
        <inertial>
            <mass value="2.5"/>
            <inertia ixx="0.0444270833" ixy="0" ixz="0" iyy="0.04442708333" iyz="0" izz="0.0768125"/>
        </inertial>
        <visual>
            <geometry><mesh filename="package://uv_disinfection_robot/meshes/ros_robot_Base.stl"/></geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <geometry><cylinder radius="0.18" length="0.10"/></geometry>
        </collision>
        <visual name="base_led_visual">
            <geometry><mesh filename="package://uv_disinfection_robot/meshes/ros_robot_Base_Led.stl"/></geometry>
            <material name="red"/>
        </visual>
        <collision name="base_led_collision">
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <geometry><cylinder radius="0.18" length="0.10"/></geometry>
        </collision>
    </link>

    <link name="capsule_link">
        <inertial>
            <mass value="1"/>
            <inertia ixx="0.169982833" ixy="0" ixz="0" iyy="0.169982833" iyz="0" izz="0.006733"/>
        </inertial>
        <visual>
            <geometry><mesh filename="package://uv_disinfection_robot/meshes/ros_robot_Top.stl"/></geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.45" rpy="0 0 0"/>
            <geometry><cylinder radius="0.15" length="0.60"/></geometry>
        </collision>
        <visual name="top_led_visual">
            <geometry><mesh filename="package://uv_disinfection_robot/meshes/ros_robot_Top_Led.stl"/></geometry>
            <material name="red"/>
        </visual>
        <collision name="top_led_collision">
            <geometry><mesh filename="package://uv_disinfection_robot/meshes/ros_robot_Top_Led.stl"/></geometry>
        </collision>
    </link>

    <link name="sensor_laser">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <xacro:cylinder_inertia mass="0.2" r="0.06" l="0.02"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.06" length="0.02"/></geometry>
            <material name="blue"/>
        </visual>
    </link>

    <gazebo reference="sensor_laser">
        <sensor type="ray" name="head_hokuyo_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>6.2831853</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.20</min>
                    <max>30.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
            </ray>
            <plugin name="gazebo_ros_head_hokuyo_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros><remapping>~/out:=/scan</remapping></ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>sensor_laser</frame_name>
            </plugin>
        </sensor>
        <sensor type="ray" name="uv_3d_lidar">
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <update_rate>$(arg update_rate)</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>$(arg samples)</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>6.2831853</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>$(arg vertical_samples)</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.35</min_angle>
                        <max_angle>0.6</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>6.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <plugin name="gazebo_ros_uv_lidar" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=/uv_points</remapping>
                </ros>
                <output_type>sensor_msgs/PointCloud2</output_type>
                <frame_name>sensor_laser</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <joint name="base_joint" type="fixed">
        <parent link="origin_link"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.01905"/>
    </joint>
    <joint name="top_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="capsule_link"/>
        <origin xyz="0 0 0"/>
    </joint>
    <joint name="sensor_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="sensor_laser"/>
        <origin xyz="0 0 0.19225"/>
    </joint>

    <xacro:tube_macro name="back"  xyz="0 -0.065 0.23" rpy="0 0 3.14159"/>
    <xacro:tube_macro name="front" xyz="0  0.065 0.23" rpy="0 0 0"/>
    <xacro:tube_macro name="right" xyz="0.065 0 0.23"  rpy="0 0 -1.5708"/>
    <xacro:tube_macro name="left"  xyz="-0.065 0 0.23" rpy="0 0 1.5708"/>

    <xacro:rim_macro name="left"  color="0.3 0 0" xyz="-0.121244 0.07 0" rpy="1.570796326794896 0 1.047197551196597"/>
    <xacro:rim_macro name="back"  color="0 0.3 0" xyz="0 -0.140 0"       rpy="1.570796326794896 0 3.141592653589793"/>
    <xacro:rim_macro name="right" color="0 0 0.3" xyz="0.121244 0.07 0"  rpy="1.570796326794896 0 -1.047197551196597"/>

    <ros2_control name="GazeboSimSystem" type="system">
        <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
        <joint name="rim_left_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="rim_back_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="rim_right_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="front_servo_base_joint"><command_interface name="position"/><state_interface name="position" initial_value="0.0"/><state_interface name="velocity"/></joint>
        <joint name="back_servo_base_joint"><command_interface name="position"/><state_interface name="position" initial_value="0.0"/><state_interface name="velocity"/></joint>
        <joint name="left_servo_base_joint"><command_interface name="position"/><state_interface name="position" initial_value="0.0"/><state_interface name="velocity"/></joint>
        <joint name="right_servo_base_joint"><command_interface name="position"/><state_interface name="position" initial_value="0.0"/><state_interface name="velocity"/></joint>
        <joint name="front_base_tube_joint"><command_interface name="position"/><state_interface name="position" initial_value="1.5708"/><state_interface name="velocity"/></joint>
        <joint name="back_base_tube_joint"><command_interface name="position"/><state_interface name="position" initial_value="1.5708"/><state_interface name="velocity"/></joint>
        <joint name="left_base_tube_joint"><command_interface name="position"/><state_interface name="position" initial_value="1.5708"/><state_interface name="velocity"/></joint>
        <joint name="right_base_tube_joint"><command_interface name="position"/><state_interface name="position" initial_value="1.5708"/><state_interface name="velocity"/></joint>
    </ros2_control>

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find uv_disinfection_robot)/config/ros2_controllers.yaml</parameters>
            <ros>
                <remapping>/left_joint_velocity_controller/command:=/left_joint_velocity_controller/commands</remapping>
                <remapping>/back_joint_velocity_controller/command:=/back_joint_velocity_controller/commands</remapping>
                <remapping>/right_joint_velocity_controller/command:=/right_joint_velocity_controller/commands</remapping>
            </ros>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name="gazebo_ros_planar_move" filename="libgazebo_ros_planar_move.so">
            <ros><remapping>cmd_vel:=/cmd_vel_phys</remapping></ros>
            <update_rate>100</update_rate>
            <publish_odom>false</publish_odom>
            <publish_odom_tf>false</publish_odom_tf>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>origin_link</robot_base_frame>
            <odometry_source>0</odometry_source>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name="gazebo_ros_p3d" filename="libgazebo_ros_p3d.so">
            <ros><remapping>odom:=/odom_gt</remapping></ros>
            <frame_name>world</frame_name>
            <body_name>origin_link</body_name>
            <update_rate>50.0</update_rate>
        </plugin>
    </gazebo>
<!-- ================= CAMERA (lens object on the neck, no cube) ================= -->
    <link name="camera_link">
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="capsule_link"/>
        <child link="camera_link"/>
        <origin xyz="0.0 -0.06 1.7" rpy="0 0 -1.5708"/>
    </joint>

    <!-- ============ ZED STEREO CAMERA (left/right, 12 cm baseline) ============ -->

    <!-- ============ INTEL REALSENSE D455 style RGB-D (color + depth + points) ============ -->
    <gazebo reference="camera_link">
        <sensor type="camera" name="rs_color">
            <update_rate>30.0</update_rate>
            <camera name="rs_color">
                <horizontal_fov>1.518</horizontal_fov>  <!-- 87 deg -->
                <image><width>640</width><height>480</height><format>R8G8B8</format></image>
                <clip><near>0.1</near><far>30</far></clip>
            </camera>
            <plugin name="rs_color_ctrl" filename="libgazebo_ros_camera.so">
                <ros>
                    <remapping>~/image_raw:=/camera/color/image_raw</remapping>
                    <remapping>~/camera_info:=/camera/color/camera_info</remapping>
                </ros>
                <camera_name>rs_color</camera_name>
                <frame_name>camera_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor type="depth" name="rs_depth">
            <update_rate>30.0</update_rate>
            <camera name="rs_depth">
                <horizontal_fov>1.518</horizontal_fov>
                <image><width>640</width><height>480</height><format>R8G8B8</format></image>
                <clip><near>0.6</near><far>6.0</far></clip>
            </camera>
            <plugin name="rs_depth_ctrl" filename="libgazebo_ros_camera.so">
                <ros>
                    <remapping>~/image_raw:=/camera/depth/image_raw</remapping>
                    <remapping>~/camera_info:=/camera/depth/camera_info</remapping>
                    <remapping>~/points:=/camera/depth/points</remapping>
                </ros>
                <camera_name>rs_depth</camera_name>
                <frame_name>camera_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="origin_link">
        <kinematic>true</kinematic>
    </gazebo>
</robot>
